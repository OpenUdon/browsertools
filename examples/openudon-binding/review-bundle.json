    "actions": {
      "extract_article": {
        "description": "Extracts the canonical name, short description, and first-level categories of the currently loaded Wikipedia article. Uses schema.org microdata embedded in the page head for name and description; extracts categories via CSS because they are not exposed as microdata.\n",
        "parameters": {"properties": {}, "type": "object"},
        "sequence": [{"wait_for": {"role": "heading"}}],
        "outputs": {
          "article_url": {"type": "string", "source": "microdata", "property": "url"},
          "categories": {
            "type": "array",
            "source": "css",
            "selector": "#mw-normal-catlinks ul li a",
            "fallbackReason": "no_a11y_region",
            "validation": {"items": {"type": "string"}, "type": "array"}
          },
          "description": {"type": "string", "source": "microdata", "property": "description"},
          "name": {"type": "string", "source": "microdata", "property": "name"}
        },
        "sideEffects": ["read_only"],
        "confirmationPolicy": {"required": false}
      },
      "navigate_to_article": {
        "description": "Navigates to a Wikipedia article by its page title. The title is used directly in the URL path. After navigation the action inspects whether the landed page is a disambiguation page by checking for the presence of the disambiguation footer link in the accessibility tree.\n",
        "parameters": {
          "properties": {
            "title": {
              "description": "Wikipedia page title, URL-encoded if necessary. Use the unqualified title for the first attempt (e.g. \"Python\") and the qualified title with parenthetical disambiguator on retry (e.g. \"Python_(programming_language)\").\n",
              "type": "string"
            }
          },
          "required": ["title"],
          "type": "object"
        },
        "sequence": [
          {"navigate": "/wiki/{{title}}"},
          {"wait_for": {"navigation": "domcontentloaded"}}
        ],
        "outputs": {
          "is_disambiguation": {
            "type": "boolean",
            "source": "a11y",
            "locator": {"role": "link", "name": "Disambiguation"},
            "presence": true
          },
          "page_title": {"type": "string", "source": "microdata", "property": "name"}
        },
        "sideEffects": ["read_only"],
        "confirmationPolicy": {"required": false}
      }
    }
